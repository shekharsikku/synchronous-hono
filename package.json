{
  "name": "synchronous-hono",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --build --clean && tsc --build && tsc-alias",
    "start": "bun run dist/index.js",
    "check": "bunx biome check --write",
    "lint": "bunx biome lint --write",
    "format": "bunx biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/bun": "latest",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@socket.io/bun-engine": "^0.1.0",
    "argon2": "^0.43.1",
    "dotenv": "^16.6.1",
    "envalid": "^8.1.1",
    "hono": "^4.11.5",
    "imagekit": "^6.0.0",
    "jose": "^6.1.3",
    "mongoose": "^9.1.5",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  }
}
