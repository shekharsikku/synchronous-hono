{
  "name": "synchronous-hono",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --build --clean && tsc --build && tsc-alias",
    "start": "bun run dist/index.js",
    "check": "bunx biome check --write",
    "lint": "bunx biome lint --write",
    "format": "bunx biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.11.12",
    "@socket.io/bun-engine": "^0.1.1",
    "argon2": "^0.44.0",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "hono": "^4.12.34",
    "hono-pino": "^0.10.3",
    "hono-rate-limiter": "^0.5.3",
    "imagekit": "^6.0.0",
    "jose": "^6.2.7",
    "mongoose": "^9.9.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
